# =============================================================================
# AgriSmart AI - Backend environment variables
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# Everything here is a placeholder - do not paste real secrets into git.
# =============================================================================

# --- App ---
APP_NAME=AgriSmart AI
ENVIRONMENT=development
DEBUG=true
# Set to false in production to hide /docs, /redoc, and /openapi.json.
ENABLE_API_DOCS=true

# --- Database (Supabase PostgreSQL) ---
# Use the connection string from Supabase > Project Settings > Database.
# Prefer the "Connection pooling" (Supavisor) URI on port 6543 for the free tier.
# SQLAlchemy needs the psycopg (v3) driver prefix.
DATABASE_URL=postgresql+psycopg://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Safe to expose to clients (RLS enforced):
SUPABASE_ANON_KEY=<publishable-or-anon-key>
# SECRET - backend only, never ship to Flutter:
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Found in Supabase > Project Settings > API > JWT Settings. Used to verify
# legacy HS256 user tokens. Projects on the newer asymmetric signing keys do not
# need it; their tokens are verified via the JWKS endpoint below.
SUPABASE_JWT_SECRET=<jwt-secret>
# Optional: pin the expected token issuer. Defaults to "<SUPABASE_URL>/auth/v1"
# when left empty; set explicitly only to override.
SUPABASE_JWT_ISSUER=
# Optional: asymmetric (ES256/RS256) token verification uses this JWKS endpoint.
# Defaults to "<SUPABASE_URL>/auth/v1/.well-known/jwks.json" when left empty.
SUPABASE_JWKS_URL=

# --- Weather (WeatherAPI.com) ---
WEATHER_API_KEY=<weatherapi-com-key>
WEATHER_API_BASE_URL=https://api.weatherapi.com/v1
WEATHER_CACHE_TTL_SECONDS=600

# --- AI assistant provider (optional) ---
# Supported: none | gemini | openai | ollama
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_SECONDS=30
# Caps the reply length to bound provider cost.
AI_MAX_OUTPUT_TOKENS=800

# --- Crop-disease model (PyTorch / TorchScript) ---
# Path to a TorchScript file produced by `python ml/train.py`. Leave empty to
# disable detection (the API returns 503). The file is not committed.
MODEL_PATH=
MODEL_INPUT_SIZE=224

# --- CORS (comma-separated origins, or * for development) ---
CORS_ORIGINS=*

# --- Rate limiting (per client IP; protects paid/external endpoints) ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_DIAGNOSE=30/minute
RATE_LIMIT_WEATHER=60/minute
# In-memory by default (single instance); use a Redis URI when scaling out.
RATE_LIMIT_STORAGE_URI=memory://
# Comma-separated proxy IPs whose X-Forwarded-For is trusted (empty = untrusted).
TRUSTED_PROXY_IPS=

# --- Hardening / cost controls ---
SECURITY_HEADERS_ENABLED=true
GZIP_MIN_SIZE=1024
# Reject request bodies larger than this before reading them (bytes).
MAX_REQUEST_BYTES=12582912
# Allowed Host header values for TrustedHostMiddleware ("*" = any).
ALLOWED_HOSTS=*
# Require a valid Supabase token for AI/ML/weather endpoints (guest mode when false).
REQUIRE_AUTH_FOR_AI=false

# --- Media limits (initial application defaults, not provider allowances) ---
MAX_PHOTO_BYTES=5242880
MAX_VIDEO_BYTES=20971520
MAX_VIDEO_DURATION_SECONDS=30
